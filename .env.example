# 复制为 .env 后按需修改；.env 不要提交到 git
# 本地开发用 SQLite，零安装即可跑通；接 PostgreSQL 时只改这一行
DATABASE_URL=sqlite:///./data/report.db
# DATABASE_URL=postgresql+psycopg://report:report@localhost:5432/report

# 数据源：mock_api = 调接口采集；mock_web = 用浏览器自动化采集；public_site = 抓公开网页
SOURCE=mock_api

# 模拟电商后台地址（先启动 mock_server.py）
MOCK_API_BASE=http://127.0.0.1:8000

# 飞书群机器人 webhook，留空则只打印到控制台并落文件
FEISHU_WEBHOOK=

# 预警阈值
GM_ALERT=0.15          # 毛利率低于 15% 预警
STOCK_DAYS_MAX=45      # 库存周转天数高于 45 天预警（滞销）
STOCK_DAYS_MIN=7       # 低于 7 天预警（断货风险）
RETURN_RATE_ALERT=0.10 # 退货率高于 10% 预警
AD_RATIO_ALERT=0.5    # 推广费占 GMV 高于 50% 预警

# 推送策略：always = 每天都推（有心跳，能区分"没预警"和"没跑"）；high_only = 仅高危预警才推
PUSH_POLICY=always

# 口径参数（决定毛利算不算得对，面试会问）
# 退货商品成本可回收比例：
#   0.0 = 退货即报废（内衣/内裤/食品等贴身或开封类目，行业惯例不可二次销售）
#   0.5 = 退货可折价清仓
#   1.0 = 退货完好入库，可原价再售（外穿服装/3C/家居）
RETURN_COST_RECOVERY=0.0
# 平台是否对退款订单退还技术服务费（抖音/天猫均退，设为 false 表示不退佣）
REFUND_COMMISSION_ON_RETURN=true
